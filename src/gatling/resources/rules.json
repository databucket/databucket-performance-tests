{
  "active": {
    "description": "ACTIVE users (60 % of the rows)",
    "rules": [["$.status", "==", "ACTIVE"]]
  },
  "new": {
    "description": "NEW users (10 %)",
    "rules": [["$.status", "==", "NEW"]]
  },
  "premium-pl": {
    "description": "PREMIUM users from PL (two conditions, ~3 %)",
    "rules": [["$.type", "==", "PREMIUM"], ["$.country", "==", "PL"]]
  },
  "age-range": {
    "description": "users aged 30-39 (number range, ~16 %)",
    "rules": [["$.age", ">=", 30], ["$.age", "<", 40]]
  },
  "blocked-or-inactive-de": {
    "description": "BLOCKED or INACTIVE users from DE (or + a condition, ~5 %)",
    "rules": [{"or": [["$.status", "==", "BLOCKED"], ["$.status", "==", "INACTIVE"]]}, ["$.country", "==", "DE"]]
  },
  "group": {
    "description": "one group (n % 5000 = 42: 20 rows in 100k, 200 in 1M); fewer free rows than users = failed reservations",
    "rules": [["$.group", "==", "group-42"]]
  },
  "login-like": {
    "description": "login starting with user-12 (like)",
    "rules": [["$.login", "like", "user-12%"]]
  },
  "seller": {
    "description": "users with the role seller (value in an array)",
    "rules": [["seller", "in", "$.roles"]]
  }
}
